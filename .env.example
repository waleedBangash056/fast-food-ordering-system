# ============================================================================
# SMASH & SIZZLE (FAST-FOOD) — LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# Copy to an untracked `.env.local` file for local development ONLY.
# NEVER commit real secrets to Git or paste production Supabase credentials
# into `.env.example` or local `.env*` files. Configure production secrets
# exclusively in the Render environment dashboard.
# ============================================================================

# 1. Runtime Environment ("development" | "test" | "production")
NODE_ENV=development

# 2. PostgreSQL Runtime Connection (Used EXCLUSIVELY by the Next.js runtime app)
# - When `DATABASE_URL` is left unset/commented out in non-production (`NODE_ENV !== "production"`),
#   the application runs in local non-persistent in-memory fallback mode seeded from `src/lib/db/seed-data.ts`
#   (all runtime mutations are stored in volatile process memory and reset on server restart).
# - In production (`NODE_ENV=production`), `DATABASE_URL` is strictly required and the runtime fails closed
#   (HTTP 503 CONFIG_ERROR) if `DATABASE_URL` is unset.
# - To test against a local PostgreSQL instance, uncomment the line below in `.env.local` (NEVER point
#   local development at the shared production Supabase database):
# DATABASE_URL=postgresql://fastfood_runtime_role:local_dev_password@localhost:5432/fastfood_local_dev

# 3. PostgreSQL Migration & Seed Connection (Required by `npx drizzle-kit migrate` and `npm run db:seed`)
# - Uses `fastfood_migrator_role` exclusively; never falls back to `DATABASE_URL` and is never read by
#   the Next.js runtime (`src/lib/db/index.ts`).
# - Uncomment in `.env.local` or pass inline only when running local migrations or seeding:
# MIGRATION_DATABASE_URL=postgresql://fastfood_migrator_role:local_migrator_password@localhost:5432/fastfood_local_dev

# 4. Staff Session Signing Secret (Required in production; min 32 random bytes / 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_char_hex_cryptographic_secret_before_deployment

# 5. Production Staff Bootstrap Credentials (Required when NODE_ENV=production)
# Supports plaintext or scrypt$<salt_hex>$<derived_key_hex> format.
ADMIN_EMAIL=admin@smashsizzle.com
ADMIN_PASSWORD=replace_with_strong_admin_password_or_scrypt_hash
KITCHEN_OPERATOR_EMAIL=chef@smashsizzle.com
KITCHEN_OPERATOR_PASSWORD=replace_with_strong_kitchen_password_or_scrypt_hash
BRANCH_MANAGER_EMAIL=manager@smashsizzle.com
BRANCH_MANAGER_PASSWORD=replace_with_strong_manager_password_or_scrypt_hash
STAFF_EMAIL=staff@smashsizzle.com
STAFF_PASSWORD=replace_with_strong_staff_password_or_scrypt_hash

# 6. Payment & Webhook Security
# Safe default is `PAYMENT_MODE=DISABLED` (fail-closed until a real payment gateway is configured).
# - In production (`NODE_ENV=production`), mock payments are strictly blocked regardless of `PAYMENT_MODE`.
# - For local development checkout testing ONLY, explicitly opt into sandbox mock payments by setting
#   `PAYMENT_MODE=MOCK` in your untracked `.env.local` file.
# - Supported values: "DISABLED" | "MOCK" (non-production only) | "STRIPE" | "HMAC_SIGNED"
PAYMENT_MODE=DISABLED
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_hmac_signing_secret


